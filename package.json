{
  "name": "@wearearchangel/static",
  "version": "1.0.0",
  "description": "Handcrafted Design System — CSS baseline, tokens, and static assets",
  "license": "MIT",
  "files": [
    "fonts/",
    "styles/",
    "manifest/"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "exports": {
    "./tokens": "./styles/tokens.css",
    "./main.css": "./styles/main.css",
    "./main.tailwind.css": "./styles/main.tailwind.css",
    "./components.css": "./styles/components.css",
    "./styles/*": "./styles/*"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@handcraftech/eslint-config-handcrafted": "github:handcraftech/eslint-config-handcrafted",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "@aws-amplify/backend": "^1.24.1",
    "@aws-amplify/backend-cli": "^1.9.1",
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "aws-amplify": "^6.20.0"
  }
}
